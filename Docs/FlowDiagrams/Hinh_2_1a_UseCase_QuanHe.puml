UC_Chat ..> UC_Login : <<include>>
UC_Dashboard ..> UC_Login : <<include>>
UC_Reports ..> UC_Login : <<include>>
UC_ManageUsers ..> UC_Login : <<include>>
UC_Backup ..> UC_Login : <<include>>

'--- include Check Permission ---
UC_ManageUsers2 ..> UC_CheckPerm : <<include>>
UC_ApprovePost2 ..> UC_CheckPerm : <<include>>
UC_Backup2 ..> UC_CheckPerm : <<include>>
UC_Reports2 ..> UC_CheckPerm : <<include>>
UC_Terminate ..> UC_CheckPerm : <<include>>
UC_Houses2 ..> UC_CheckPerm : <<include>>

'--- include Send Notification ---
UC_CreateContract2 ..> UC_Notify : <<include>>
UC_AssignTenant ..> UC_Notify : <<include>>
UC_AcceptContract2 ..> UC_Notify : <<include>>
UC_ReqCancel ..> UC_Notify : <<include>>
