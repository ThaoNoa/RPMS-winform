@startuml Hinh_2_1_UseCase_DayDu
'==============================================================================
' Hình 2.1 (bản đầy đủ 1 trang) – Use Case + Association + Include + Extend
' Dùng khi cần 1 file duy nhất; khuyến nghị in A3 dọc hoặc xem SVG zoom
'==============================================================================

skinparam shadowing false
skinparam handwritten false
skinparam roundcorner 8
skinparam dpi 200
skinparam nodesep 16
skinparam ranksep 18
skinparam packageStyle rectangle

skinparam actor {
  BackgroundColor #DBEAFE
  BorderColor #2563EB
  FontColor #1E3A8A
  FontSize 11
  FontStyle bold
}

skinparam usecase {
  BackgroundColor #FFFBEB
  BorderColor #111827
  FontSize 9
  FontColor #111827
}

skinparam package {
  BackgroundColor #F8FAFC
  BorderColor #64748B
  FontColor #0F172A
  FontSize 10
  FontStyle bold
}

skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #0F172A
  FontColor #0F172A
  FontSize 12
  FontStyle bold
}

skinparam note {
  BackgroundColor #F8FAFC
  BorderColor #94A3B8
  FontSize 8
}

skinparam arrow {
  Color #475569
  FontSize 7
}

title <b>Hình 2.1 (đầy đủ) – Use Case Diagram RPMS</b>\nActors · Associations · <<include>> · <<extend>> · Generalization

actor "Admin\n(Quản trị viên)" as Admin #BFDBFE
actor "Landlord\n(Chủ nhà)" as Landlord #BBF7D0
actor "Tenant\n(Người thuê)" as Tenant #FDE68A
actor "Manager\n(Quản lý viên)" as Manager #FBCFE8
actor "Guest\n(Khách xem)" as Guest #E2E8F0
actor "User\n(Người dùng)" as User #DBEAFE

Admin --|> User
Landlord --|> User
Tenant --|> User
Manager --|> User

rectangle "Hệ thống RPMS (Rental Property Management System)" {

  package "a. Tài khoản & xác thực" as P_Auth #EFF6FF {
    usecase "Đăng nhập (Login)" as UC_Login
    usecase "Đăng ký (Register)" as UC_Register
    usecase "Đổi mật khẩu" as UC_ChangePwd
    usecase "Cập nhật hồ sơ" as UC_UpdateProfile
    usecase "Đăng xuất (Logout)" as UC_Logout
    usecase "Xác thực quyền\n(Check Permission)" as UC_CheckPerm
    usecase "Gửi thông báo\n(Send Notification)" as UC_Notify
    usecase "Ghi nhật ký\n(Log Activity)" as UC_Log
  }

  package "b. Quản lý tài sản" as P_Asset #ECFDF5 {
    usecase "Quản lý nhà" as UC_Houses
    usecase "Quản lý phòng" as UC_Rooms
    usecase "Quản lý tiện nghi" as UC_Amenities
    usecase "Quản lý ảnh phòng" as UC_RoomImages
    usecase "Xem chi tiết phòng" as UC_RoomDetails
  }

  package "c. Quản lý tin đăng" as P_Post #FEF3C7 {
    usecase "Đăng tin cho thuê" as UC_CreatePost
    usecase "Duyệt tin đăng" as UC_ApprovePost
    usecase "Xem tin đăng" as UC_ViewPosts
  }

  package "d. Quản lý hợp đồng" as P_Contract #FFEDD5 {
    usecase "Tạo hợp đồng" as UC_CreateContract
    usecase "Gán khách thuê" as UC_AssignTenant
    usecase "Xem hợp đồng" as UC_ViewContract
    usecase "Xác nhận hợp đồng" as UC_AcceptContract
    usecase "Từ chối hợp đồng" as UC_RejectContract
    usecase "Sửa hợp đồng" as UC_EditContract
    usecase "Xác nhận sửa HĐ" as UC_ConfirmEdit
    usecase "Từ chối sửa HĐ" as UC_RejectEdit
    usecase "Yêu cầu hủy HĐ" as UC_ReqCancel
    usecase "Duyệt hủy HĐ" as UC_ApproveCancel
    usecase "Từ chối hủy HĐ" as UC_RejectCancel
    usecase "Thanh lý HĐ" as UC_Terminate
    usecase "Gia hạn HĐ" as UC_Extend
    usecase "In hợp đồng" as UC_PrintContract
    usecase "Xem DS khách đặt lịch" as UC_ViewApptTenants
  }

  package "e. Hóa đơn & thanh toán" as P_Invoice #FCE7F3 {
    usecase "Ghi chỉ số ĐN" as UC_Meter
    usecase "Tạo hóa đơn" as UC_GenInvoice
    usecase "Xem hóa đơn" as UC_ViewInvoice
    usecase "Thanh toán hóa đơn" as UC_PayInvoice
    usecase "Xuất hóa đơn" as UC_ExportInvoice
  }

  package "f. Lịch hẹn" as P_Appt #E0E7FF {
    usecase "Đặt lịch hẹn" as UC_BookAppt
    usecase "Xác nhận lịch hẹn" as UC_ConfirmAppt
    usecase "Từ chối lịch hẹn" as UC_RejectAppt
  }

  package "g. Sự cố" as P_Maint #FEE2E2 {
    usecase "Gửi YC bảo trì" as UC_CreateMaint
    usecase "Xử lý YC bảo trì" as UC_ProcessMaint
  }

  package "h. Tương tác khác" as P_Other #F3E8FF {
    usecase "Quản lý yêu thích" as UC_Favorites
    usecase "Thêm yêu thích" as UC_AddFav
    usecase "Quản lý đánh giá" as UC_Reviews
    usecase "Xem đánh giá" as UC_ViewReviews
    usecase "Trả lời đánh giá" as UC_ReplyReview
    usecase "Chat" as UC_Chat
    usecase "Xem Dashboard" as UC_Dashboard
    usecase "Xem báo cáo" as UC_Reports
  }

  package "i. Quản trị hệ thống" as P_Admin #DBEAFE {
    usecase "Quản lý người dùng" as UC_ManageUsers
    usecase "Xem nhật ký" as UC_ViewLog
    usecase "Sao lưu dữ liệu" as UC_Backup
  }
}

